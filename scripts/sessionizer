#!/usr/bin/env bash

source "$HOME/scripts/config.sh"
source "$HOME/scripts/lib/tmux.sh"
source "$HOME/scripts/lib/frecency.sh"

if [[ $# -eq 1 ]]; then
	selected="$1"
else
	selected=$(frecency_select_dir "Select session: ")
fi

[[ -z "$selected" ]] && exit 0

frecency_touch "$selected"
tmux_open_or_switch "$selected"
