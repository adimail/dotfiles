#!/usr/bin/env bash

source "$HOME/scripts/config.sh"
source "$HOME/scripts/lib/tmux.sh"
source "$HOME/scripts/lib/frecency.sh"
source "$HOME/scripts/lib/input.sh"

base=$(
	{
		frecency_parents
		printf "%s\n" "${STATIC_PARENT_DIRS[@]}"
	} | awk '!seen[$0]++' | fzf --prompt="Select a base directory to clone into: "
)

base=$(eval echo "$base")

if [[ -z "$base" ]]; then
	echo "No directory selected. Exiting."
	exit 1
fi

prompt_input "Enter the Git repository URL or owner/repo: " repo_input

if [[ -z "$repo_input" ]]; then
	echo "No input provided. Exiting."
	exit 1
fi

if [[ "$repo_input" =~ ^https?://github\.com/([^/]+)/([^/\.]+)(\.git)?/?$ ]]; then
	owner="${BASH_REMATCH[1]}"
	repo_name="${BASH_REMATCH[2]}"
elif [[ "$repo_input" =~ ^([^/]+)/([^/\.]+)(\.git)?/?$ ]]; then
	owner="${BASH_REMATCH[1]}"
	repo_name="${BASH_REMATCH[2]}"
else
	echo "Invalid repository format. Please use 'owner/repo' or a GitHub URL."
	exit 1
fi

repo_url="https://github.com/${owner}/${repo_name}.git"
clone_path="$base/$repo_name"

prompt_input "Enter maximum depth (press Enter for no limit): " max_depth

clone_cmd="git clone --single-branch"
[[ -n "$max_depth" ]] && clone_cmd="$clone_cmd --depth $max_depth"

echo ""
echo "Repository owner: $owner"
echo "Repository name: $repo_name"
echo "Repository URL: $repo_url"
echo "Clone path: $clone_path"
echo "Clone command: $clone_cmd"
echo ""

if [[ -d "$clone_path" ]]; then
	read -n 1 -rp "Directory $repo_name already exists. Press 'l' to open it in tmux, or any other key to exit: " choice
	echo
	if [[ "$choice" != "l" ]]; then
		echo "Operation cancelled. Exiting."
		exit 1
	fi
else
	echo "Cloning repository..."
	if ! $clone_cmd "$repo_url" "$clone_path"; then
		echo "Failed to clone repository. Exiting."
		exit 1
	fi
	echo "Cloned into $clone_path"
fi

frecency_touch "$clone_path"
tmux_open_or_switch "$clone_path"
