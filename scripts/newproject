#!/usr/bin/env bash

source "$HOME/scripts/config.sh"
source "$HOME/scripts/lib/tmux.sh"
source "$HOME/scripts/lib/frecency.sh"
source "$HOME/scripts/lib/input.sh"

base_directory=$(
	{
		frecency_parents
		printf "%s\n" "${STATIC_PARENT_DIRS[@]}"
	} | awk '!seen[$0]++' | fzf --prompt="Select a base directory: "
)

base_directory=$(eval echo "$base_directory")

if [[ -z "$base_directory" ]]; then
	echo "No directory selected. Exiting."
	exit 1
fi

prompt_input "Enter the new folder name: " folder_name

if [[ -z "$folder_name" ]]; then
	echo "No folder name provided. Exiting."
	exit 1
fi

new_folder="${base_directory%/}/$folder_name"

if [[ -d "$new_folder" ]]; then
	read -n 1 -rp "Folder '$folder_name' already exists. Press 'l' to launch tmux there, any other key to exit: " choice
	echo
	[[ "$choice" != "l" ]] && echo "Cancelled." && exit 1
else
	if ! mkdir -p "$new_folder"; then
		echo "Failed to create folder '$new_folder'. Exiting."
		exit 1
	fi
	echo "Created: $new_folder"
fi

frecency_touch "$new_folder"
tmux_open_or_switch "$new_folder"
